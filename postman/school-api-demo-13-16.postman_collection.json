                "api",
                "departments",
                "{{depId}}"
              ]
            },
            "description": "Konsolda tək select görünməlidir: from departments d1_0 left join employees e1_0 on d1_0.id=e1_0.department_id"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
