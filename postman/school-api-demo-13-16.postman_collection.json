            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo\",\n  \"surname\": \"Employee\",\n  \"salary\": 1200,\n  \"departmentId\": {{depId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"empId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Departamenti silməyə çalış (XƏTA gözlənilir)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/departments/{{depId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "departments",
                "{{depId}}"
              ]
            },
            "description": "IllegalStateException: Department has employees and cannot be deleted. Mesaj cavabdakı trace-də və IntelliJ konsolunda görünür."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 500\", () => pm.response.to.have.status(500));"
                ]
              }
            }
          ]
        }
      ]
